# Builds
Build/

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build//*
!Build//PakBlacklist.txt

# Don't ignore icon files in Build
!Build/*/.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/

# Compiled source files for the engine to use
Intermediate/
Plugins/**/Intermediate

# Cache files for the editor to use
der

# Logs that Unity creates for debugging
*.log

# Unity temporary files, crash logs, or other local data
*crashdumps/

# User settings for VSCode
.vscode/settings.json

# User-specific configurations (saves user preferences)
*.user
*.userprefs
*.suo
*.swp

# Visual Studio and JetBrains Rider
.vscode/
.idea/

# User-specific settings for Visual Studio
.vs/
.vs2019/
.vs2017/

# Ignore Unity's build directories
uidesert/Build/
uidesert/Library/
uidesert/Temp/